    function tr(value) {
        const text=String(value);const map=language === "ru" ? ru : en;
        if(map[text] !== undefined)return map[text];
        for(const key of Object.keys(map).sort((a,b) => b.length-a.length)) {
            if(text.startsWith(key+" · ") || text.startsWith(key+"  ") || text.startsWith(key+" \n") || text.startsWith(key+": ") || text.startsWith(key+"\n"))return map[key]+text.slice(key.length);
            if(text.endsWith(" · "+key))return text.slice(0,-key.length)+map[key];
        }
        return text;
    }
    function date(value,format) {return locale.toString(value,format);}
